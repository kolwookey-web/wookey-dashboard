<title>Dashboard Wookey Wight</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Sans+3:wght@400;600&display=swap">

<style>
:root{
  color-scheme:light;
  --ground:#f4f3ef; --surface:#fbfaf8; --surface-2:#efeee9;
  --line:#dedcd4; --line-soft:#e9e7e0;
  --ink:#17160f; --ink-2:#56544b; --ink-3:#807d72;
  --accent:#1f6f63; --accent-soft:#dcebe7; --on-accent:#ffffff;
  --good:#0ca30c; --warn:#fab219; --crit:#d03b3b;
  --s1:#2a78d6; --s2:#eb6834;
  --shadow:0 1px 2px rgba(23,22,15,.06),0 8px 24px -16px rgba(23,22,15,.28);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --ground:#121210; --surface:#1a1a19; --surface-2:#232321;
    --line:#33332f; --line-soft:#2a2a27;
    --ink:#f6f5f0; --ink-2:#b6b3a8; --ink-3:#8b887d;
    --accent:#4fb3a2; --accent-soft:#1c332f; --on-accent:#12120f;
    --crit:#e26060; --s1:#3987e5; --s2:#d95926;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px -16px rgba(0,0,0,.8);
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --ground:#121210; --surface:#1a1a19; --surface-2:#232321;
  --line:#33332f; --line-soft:#2a2a27;
  --ink:#f6f5f0; --ink-2:#b6b3a8; --ink-3:#8b887d;
  --accent:#4fb3a2; --accent-soft:#1c332f; --on-accent:#12120f;
  --crit:#e26060; --s1:#3987e5; --s2:#d95926;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px -16px rgba(0,0,0,.8);
}
*{box-sizing:border-box}
body{margin:0;background:var(--ground);color:var(--ink);
  font-family:"Source Sans 3",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-size:15px;line-height:1.55;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:34px 22px 72px;display:flex;flex-direction:column;gap:24px}
h1,h2,h3{font-family:Archivo,sans-serif;margin:0;text-wrap:balance;letter-spacing:-.015em}
h1{font-size:2.05rem;font-weight:700;line-height:1.1}
h2{font-size:1.02rem;font-weight:600}
.mono{font-family:"IBM Plex Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}
.eyebrow{font-family:"IBM Plex Mono",monospace;font-size:.67rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:600}
.dim{color:var(--ink-3);font-size:.82rem}

header{display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end;justify-content:space-between;
  border-bottom:2px solid var(--ink);padding-bottom:15px}
.hstamp{text-align:right;font-size:.79rem;color:var(--ink-2)}
.hstamp b{display:block;font-family:"IBM Plex Mono",monospace;font-size:.95rem;color:var(--ink);font-weight:600}

.bar{position:sticky;top:0;z-index:20;background:var(--surface);border:1px solid var(--line);
  border-radius:6px;padding:13px 15px;box-shadow:var(--shadow);
  display:flex;flex-wrap:wrap;gap:12px 16px;align-items:center}
.fld{display:flex;align-items:center;gap:7px}
.fld label{font-family:"IBM Plex Mono",monospace;font-size:.66rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);font-weight:600}
input[type=date],input[type=search]{font:inherit;font-size:.85rem;padding:6px 9px;border:1px solid var(--line);
  border-radius:5px;background:var(--ground);color:var(--ink);font-family:"IBM Plex Mono",monospace}
input[type=search]{font-family:"Source Sans 3",sans-serif;min-width:200px}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{font:inherit;font-size:.78rem;padding:5px 11px;border:1px solid var(--line);background:var(--ground);
  color:var(--ink-2);border-radius:99px;cursor:pointer;font-family:"IBM Plex Mono",monospace}
.chip[aria-pressed=true]{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.rangelab{margin-left:auto;font-family:"IBM Plex Mono",monospace;font-size:.79rem;color:var(--ink-2)}
.rangelab b{color:var(--ink)}
.sel{font:inherit;font-size:.78rem;padding:5px 9px;border:1px solid var(--line);background:var(--ground);color:var(--ink);border-radius:5px;font-family:"IBM Plex Mono",monospace;cursor:pointer;max-width:150px}
.chip.ic{padding:5px 10px;font-size:.72rem;line-height:1}
#mbtn{max-width:none;white-space:nowrap}
.ddlist{position:absolute;top:calc(100% + 4px);left:0;z-index:60;background:var(--surface);border:1px solid var(--line);border-radius:6px;box-shadow:var(--shadow);max-height:170px;overflow-y:auto;min-width:150px;padding:4px}
.ddlist button{display:block;width:100%;text-align:left;font:inherit;font-size:.76rem;font-family:"IBM Plex Mono",monospace;padding:6px 10px;border:0;background:transparent;color:var(--ink);cursor:pointer;border-radius:4px;white-space:nowrap}
.ddlist button:hover{background:var(--ground)}
.ddlist button[aria-current=true]{background:var(--accent);color:#fff}
.ddlist button[aria-pressed=true]{background:var(--accent);color:#fff}
#katlist{max-height:150px}
.rbtn{font:inherit;font-size:.8rem;padding:6px 12px;border:1px solid var(--line);background:var(--ground);color:var(--ink);border-radius:5px;cursor:pointer;font-family:"IBM Plex Mono",monospace}
.rbtn:hover{border-color:var(--accent)}
.cal{position:absolute;top:calc(100% + 6px);left:13px;z-index:60;background:var(--surface);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);padding:12px;width:250px}
.cal .chd{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.cal .chd b{font-size:.82rem}
.cal .cnav{border:1px solid var(--line);background:var(--ground);border-radius:5px;cursor:pointer;color:var(--ink);padding:2px 9px;font-family:"IBM Plex Mono",monospace;font-size:.72rem}
.cal .grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
.cal .dow{font-size:.6rem;text-align:center;color:var(--ink-3);font-family:"IBM Plex Mono",monospace;padding:2px 0}
.cal .dc{text-align:center;font-size:.75rem;padding:5px 0;border-radius:5px;cursor:pointer;color:var(--ink);font-family:"IBM Plex Mono",monospace}
.cal .dc.off{color:var(--ink-3);opacity:.3;cursor:default}
.cal .dc.in{background:var(--accent-soft)}
.cal .dc.end{background:var(--accent);color:var(--on-accent)}
.cal .chint{font-size:.66rem;color:var(--ink-3);margin-top:8px;font-family:"IBM Plex Mono",monospace}

.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:11px}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:14px 15px 13px;
  display:flex;flex-direction:column;gap:2px;box-shadow:var(--shadow)}
.kpi .lab{font-family:"IBM Plex Mono",monospace;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);font-weight:600}
.kpi .val{font-family:Archivo,sans-serif;font-size:1.55rem;font-weight:700;line-height:1.14;font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.kpi .sub{font-size:.77rem;color:var(--ink-3)}
.kbadge{display:inline-block;padding:3px 10px;border:1px solid currentColor;border-radius:6px;background:transparent;font-size:.72rem;font-weight:600;font-family:"IBM Plex Mono",monospace;letter-spacing:.02em}
.kdot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle}

.card{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:19px 20px 15px;box-shadow:var(--shadow)}
.chead{display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline;justify-content:space-between}
.chead p{margin:3px 0 0;font-size:.84rem;color:var(--ink-2);max-width:76ch}
.chead p{display:none}
.gran{font-family:"IBM Plex Mono",monospace;font-size:.72rem;color:var(--ink-3)}
.legend{display:flex;gap:15px;flex-wrap:wrap;font-size:.79rem;color:var(--ink-2);margin:10px 0 8px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px}
.chartbox{position:relative;overflow-x:auto}
svg{display:block}
.gl{stroke:var(--line-soft);stroke-width:1}
.axt{font-family:"IBM Plex Mono",monospace;font-size:9.5px;fill:var(--ink-3)}
rect.b{transition:opacity .12s}
.chartbox:hover rect.b{opacity:.42}
.chartbox rect.b:hover{opacity:1}
.hit{fill:transparent}
.tip{position:absolute;pointer-events:none;opacity:0;transform:translate(-50%,-100%);
  background:var(--ink);color:var(--ground);padding:8px 11px;border-radius:5px;font-size:.77rem;
  white-space:nowrap;box-shadow:var(--shadow);z-index:9;transition:opacity .1s}
.tip b{font-family:"IBM Plex Mono",monospace;font-weight:600}
.tip .r{display:flex;justify-content:space-between;gap:14px}

.tgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-top:14px}
.trow .tl{display:flex;justify-content:space-between;align-items:baseline;font-size:.86rem;margin-bottom:6px}
.trow .tl b{font-family:"IBM Plex Mono",monospace;font-size:1rem;font-weight:600}
.bar2{height:8px;background:var(--surface-2);border-radius:4px;overflow:hidden}
.bar2 span{display:block;height:100%;border-radius:4px;background:var(--accent)}
.bar2 span.low{background:var(--warn)}
.tfoot{display:flex;justify-content:space-between;font-size:.75rem;color:var(--ink-3);margin-top:5px}

.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0 12px}
.count{margin-left:auto;font-size:.79rem;color:var(--ink-3);font-family:"IBM Plex Mono",monospace}
.tabs{display:flex;gap:8px;margin:2px 0}
#tab-eksternal,#tab-affiliate,#tab-kol{display:flex;flex-direction:column;gap:24px}
#tab-eksternal[hidden],#tab-affiliate[hidden],#tab-kol[hidden]{display:none}
#tab-kol{display:block}
#kolFrame{width:100%;min-height:300px;border:0;display:block;background:var(--ground)}
#tab-find[hidden]{display:none}#tab-find{display:block}
#findFrame{width:100%;min-height:300px;border:0;display:block;background:var(--ground)}
#kolwait,#findwait{padding:60px 10px;text-align:center;color:var(--ink-3);font-family:'IBM Plex Mono',monospace;font-size:.82rem}
.tab{font:inherit;font-family:"IBM Plex Mono",monospace;font-size:.82rem;padding:9px 20px;border:1px solid var(--line);background:var(--ground);color:var(--ink-2);border-radius:7px;cursor:pointer;letter-spacing:.02em}
.tab[aria-selected=true]{background:var(--accent);border-color:var(--accent);color:var(--on-accent);font-weight:600}
.pmetrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin:0}
.pmcard{background:var(--surface);border:1px solid var(--line);border-radius:6px;box-shadow:var(--shadow);overflow:hidden}
.pmhead{width:100%;display:flex;align-items:center;gap:10px;padding:11px 12px;background:none;border:0;cursor:pointer;text-align:left;font:inherit;color:var(--ink)}
.pmtxt{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
.pmcard .lab{font-family:"IBM Plex Mono",monospace;font-size:.6rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);font-weight:600}
.pmcard .val{font-family:Archivo,sans-serif;font-size:1.2rem;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.pmarr{font-size:.72rem;color:var(--ink-3);transition:transform .15s;flex-shrink:0}
.pmcard.open .pmarr{transform:rotate(180deg)}
.pmcard .brk{display:none;flex-direction:column;gap:3px;padding:0 12px 11px}
.pmcard.open .brk{display:flex}
.pmcard .brk div{display:flex;justify-content:space-between;gap:8px;font-size:.68rem;color:var(--ink-3);font-family:"IBM Plex Mono",monospace}
.pmcard .brk b{color:var(--ink-2);font-weight:600;font-variant-numeric:tabular-nums}
.tscroll{overflow-x:auto;border:1px solid var(--line);border-radius:6px;max-height:640px}
table{border-collapse:collapse;width:100%;font-size:.85rem;min-width:860px;table-layout:fixed}
th,td{padding:8px 12px;text-align:right;border-bottom:1px solid var(--line-soft);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
th:first-child,td:first-child,th:nth-child(2),td:nth-child(2){text-align:left}
thead th{position:sticky;top:0;background:var(--surface-2);color:var(--ink-2);font-family:"IBM Plex Mono",monospace;
  font-size:.66rem;letter-spacing:.06em;text-transform:uppercase;font-weight:600;cursor:pointer;user-select:none;z-index:2}
thead th[aria-sort]{color:var(--accent)}
tbody tr:hover{background:var(--surface-2)}
tbody td{font-family:"IBM Plex Mono",monospace;font-variant-numeric:tabular-nums}
tbody td:first-child{font-family:"Source Sans 3",sans-serif;font-variant-numeric:normal;color:var(--ink-3);font-size:.77rem}
.uname{font-family:"IBM Plex Mono",monospace;color:var(--ink)}
.rowbar{display:block;height:3px;border-radius:2px;background:var(--s1);margin-top:3px}
.pill{display:inline-block;font-size:.66rem;letter-spacing:.05em;padding:2px 8px;border-radius:99px;
  font-family:"IBM Plex Mono",monospace;font-weight:600;text-transform:uppercase}
.pill.baru{background:var(--accent-soft);color:var(--accent)}
.pill.lama{background:var(--surface-2);color:var(--ink-3)}
.flag{color:var(--crit);font-weight:600}
.note{display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:start;
  background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--accent);
  border-radius:6px;padding:15px 17px;box-shadow:var(--shadow)}
.note svg{width:21px;height:21px;color:var(--accent);flex:none;margin-top:1px}
.note h3{font-size:.93rem;font-weight:600;margin-bottom:4px}
.note ul{margin:6px 0 0;padding-left:18px;font-size:.86rem;color:var(--ink-2)}
.note li{margin-bottom:3px}
footer{border-top:1px solid var(--line);padding-top:15px;font-size:.81rem;color:var(--ink-3);display:flex;flex-direction:column;gap:5px}
footer a{color:var(--accent)}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
@media(max-width:640px){h1{font-size:1.6rem}.wrap{padding:22px 13px 56px}.bar{position:static}}
a.uname{color:var(--ink);text-decoration:none;cursor:pointer}a.uname:hover{color:var(--accent);text-decoration:underline}
</style>

<div class="wrap">

<header>
  <div>
    <div class="eyebrow">Wookey Wight &middot; KOL &amp; Affiliate Specialist</div>
    <h1>DASHBOARD</h1>
    <div style="font-size:.9rem;color:var(--ink-2);display:none">Dari <span class="mono">Data Omset VT</span> &mdash; dikelompokkan per Tanggal Data, rentang bebas</div>
  </div>
  <div class="hstamp">
    <b id="snap">23 Agu 2026</b>
    <span id="cover">Data Okt 2024 &ndash; Agu 2026</span>
  </div>
</header>

<div class="bar">
  <button class="rbtn" id="rangebtn" aria-haspopup="true" title="Pilih rentang tanggal"></button>
  <div class="mdd" style="position:relative">
    <button class="sel" id="lbtn" title="Rentang cepat">Rentang Cepat &#9662;</button>
    <div class="ddlist" id="llist" hidden>
      <button data-n="7">7 hari terakhir</button>
      <button data-n="30">30 hari terakhir</button>
      <button data-n="90">90 hari terakhir</button>
      <button data-n="180">180 hari terakhir</button>
      <button data-n="365">1 tahun terakhir</button>
    </div>
  </div>
  <div class="mdd" style="position:relative">
    <button class="sel" id="mbtn" title="Pilih Bulan">Bulan &#9662;</button>
    <div class="ddlist" id="mlist" hidden></div>
  </div>
  <div class="mdd" style="position:relative">
    <button class="sel" id="ybtn" title="Pilih tahun">Tahun &#9662;</button>
    <div class="ddlist" id="ylist" hidden></div>
  </div>
  <button class="chip" id="allBtn">Semua</button>
  <span class="rangelab" id="rangelab"></span>
  <button class="chip ic" id="prevM" title="Periode sebelumnya" aria-label="Periode sebelumnya">&#9664;</button>
  <button class="chip ic" id="nextM" title="Periode selanjutnya" aria-label="Periode selanjutnya">&#9654;</button>
  <div class="cal" id="cal" hidden></div>
</div>

<div class="tabs" role="tablist">
  <button class="tab" id="tabEks" role="tab" aria-selected="true">Eksternal</button>
  <button class="tab" id="tabAff" role="tab" aria-selected="false">Affiliate</button>
  <button class="tab" id="tabKol" role="tab" aria-selected="false">KOL</button>
  <button class="tab" id="tabFind" role="tab" aria-selected="false">Video</button>
</div>

<div id="tab-eksternal">
<div class="kpis" id="kpis"></div>

<section class="card">
  <div class="chead"><div><h2>Performa Eksternal</h2>
    <p>Omset (balok) vs Views (garis) per Tanggal Data.</p></div>
    <span class="gran" id="g1"></span></div>
  <div class="legend"><span><i style="background:var(--s2)"></i>Omset video (kiri)</span><span><i style="background:var(--s1)"></i>Views VV (kanan)</span></div>
  <div class="chartbox" id="c1"></div>
</section>

<div class="pmetrics" id="pmetrics"></div>
<section class="card">
  <div class="chead"><div><h2>Performa Kreator</h2></div></div>
  <div class="controls">
    <input type="search" id="q" placeholder="Cari username&hellip;" aria-label="Cari username">
    <select class="sel" id="topn" title="Jumlah baris">
      <option value="25">25 teratas</option>
      <option value="50">50 teratas</option>
      <option value="100">100 teratas</option>
      <option value="0">Semua</option>
    </select>
    <div class="mdd" style="position:relative">
      <button class="sel" id="katbtn" title="Saring kategori">Kategori &#9662;</button>
      <div class="ddlist" id="katlist" hidden></div>
    </div>
    <span class="count" id="cnt"></span>
    <div class="mdd" style="position:relative;margin-left:auto">
      <button class="sel" id="picbtn" title="Saring PIC">Semua PIC &#9662;</button>
      <div class="ddlist" id="piclist" hidden></div>
    </div>
  </div>
  <div class="tscroll">
    <table><colgroup>
      <col style="width:180px"><col style="width:104px">
      <col style="width:124px"><col style="width:112px"><col style="width:112px">
      <col style="width:80px"><col style="width:74px"><col style="width:96px">
    </colgroup><thead><tr>
            <th data-k="user">Username</th>
      <th data-k="kat">Kategori</th>
      <th data-k="omset" aria-sort="descending">Omset Video</th>
      <th data-k="views">View</th>
      <th data-k="klik">Klik Produk</th>
      <th data-k="ctr">CTR</th>
      <th data-k="vt">Video</th>
      <th data-k="pic">PIC</th>
    </tr></thead><tbody id="tb"></tbody></table>
  </div>
</section>

</div><!--/tab-eksternal-->

<div id="tab-affiliate" hidden>
<div class="kpis" id="kpisDeal"></div>

<section class="card">
  <div class="chead"><div><h2>Affiliate Deal</h2></div>
    <span class="gran" id="g3"></span></div>
  <div class="legend"><span><i style="background:var(--accent)"></i>GMV akun deal (kiri)</span><span><i style="background:var(--warn)"></i>Postingan (kanan)</span></div>
  <div class="chartbox" id="c3"></div>
</section>

<section class="card">
  <div class="chead"><div><h2>Target bulanan</h2>
    <p>GMV video (Data Omset VT) &amp; jumlah video (Data Jumlah VT) per bulan dibanding target Rp 1,6 M &amp; 15.000 video. Menampilkan <b>3 bulan terakhir</b> mengikuti bulan akhir rentang tanggal di atas.</p></div></div>
  <div class="tgrid" id="targets"></div>
</section>

<div class="pmetrics" id="pmetrics2"></div>
<section class="card">
  <div class="chead"><div><h2>Performa Kreator &mdash; Affiliate</h2></div></div>
  <div class="controls">
    <input type="search" id="q2" placeholder="Cari username&hellip;" aria-label="Cari username">
    <select class="sel" id="topn2" title="Jumlah baris">
      <option value="25">25 teratas</option>
      <option value="50">50 teratas</option>
      <option value="100">100 teratas</option>
      <option value="0">Semua</option>
    </select>
    <div class="mdd" style="position:relative">
      <button class="sel" id="katbtn2" title="Saring kategori">Kategori &#9662;</button>
      <div class="ddlist" id="katlist2" hidden></div>
    </div>
    <span class="count" id="cnt2"></span>
    <div class="mdd" style="position:relative;margin-left:auto">
      <button class="sel" id="picbtn2" title="Saring PIC">Semua PIC &#9662;</button>
      <div class="ddlist" id="piclist2" hidden></div>
    </div>
  </div>
  <div class="tscroll">
    <table><colgroup>
      <col style="width:180px"><col style="width:104px">
      <col style="width:124px"><col style="width:112px"><col style="width:112px">
      <col style="width:80px"><col style="width:74px"><col style="width:96px">
    </colgroup><thead><tr>
            <th data-k="user">Username</th>
      <th data-k="kat">Kategori</th>
