const TBL2=makeTable('2',['Affiliate','Anonim']);
function renderAll(){compute();renderKPI();renderCharts();renderTargets();TBL1.render();TBL2.render();syncBar();kolBroadcast();}
function showTab(t){
  el('tab-eksternal').hidden=(t!=='eks');
  el('tab-affiliate').hidden=(t!=='aff');
  el('tabEks').setAttribute('aria-selected',t==='eks'?'true':'false');
  el('tabAff').setAttribute('aria-selected',t==='aff'?'true':'false');
  el('tab-kol').hidden=(t!=='kol');
  el('tabKol').setAttribute('aria-selected',t==='kol'?'true':'false');
  el('tab-find').hidden=(t!=='find');
  el('tabFind').setAttribute('aria-selected',t==='find'?'true':'false');
  var _bar=document.querySelector('.bar'); if(_bar)_bar.style.display=(t==='find')?'none':'';
  if(t==='kol'){loadKol();kolBroadcast();}else if(t==='find'){loadFind();}else{renderCharts();}
}
el('tabEks').addEventListener('click',()=>showTab('eks'));
el('tabAff').addEventListener('click',()=>showTab('aff'));
el('tabKol').addEventListener('click',()=>showTab('kol'));
el('tabFind').addEventListener('click',()=>showTab('find'));
var _findLoaded=false;
function findTheme(){var f=el('findFrame');if(!f||!_findLoaded||!f.contentWindow)return;var t=document.documentElement.getAttribute('data-theme');f.contentWindow.postMessage({__theme:(t==='dark'||t==='light')?t:null},'*');}
async function loadFind(){ if(_findLoaded) return; _findLoaded=true;
  try{ var b64=document.getElementById('findsrc').textContent.trim();
    var bin=Uint8Array.from(atob(b64),function(c){return c.charCodeAt(0);});
    var buf=await new Response(new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();
    var f=document.getElementById('findFrame'); f.srcdoc=new TextDecoder('utf-8').decode(buf); f.hidden=false;
    var w=document.getElementById('findwait'); if(w) w.style.display='none';
  }catch(err){ _findLoaded=false; var w2=document.getElementById('findwait'); if(w2) w2.textContent='Gagal memuat Find Data: '+err; }
}
var _kolLoaded=false;
function kolBroadcast(){var f=el('kolFrame');if(!f||!_kolLoaded||!f.contentWindow)return;var all=(i1===0&&i2===NDAY-1);f.contentWindow.postMessage({__setRange:{from:all?'*':DATES[i1],to:all?'*':DATES[i2]}},'*');}
function kolTheme(){var f=el('kolFrame');if(!f||!_kolLoaded||!f.contentWindow)return;var t=document.documentElement.getAttribute('data-theme');f.contentWindow.postMessage({__theme:(t==='dark'||t==='light')?t:null},'*');}
try{new MutationObserver(function(){kolTheme();findTheme();}).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});if(window.matchMedia){var _mq=matchMedia('(prefers-color-scheme:dark)');if(_mq.addEventListener)_mq.addEventListener('change',function(){kolTheme();findTheme();});}}catch(_){}
async function loadKol(){ if(_kolLoaded) return; _kolLoaded=true;
  try{
    var b64=document.getElementById('kolsrc').textContent.trim();
    var bin=Uint8Array.from(atob(b64),function(c){return c.charCodeAt(0);});
    var stream=new Blob([bin]).stream().pipeThrough(new DecompressionStream('gzip'));
    var buf=await new Response(stream).arrayBuffer();
    var html=new TextDecoder('utf-8').decode(buf);
    var f=document.getElementById('kolFrame');
    f.srcdoc=html; f.hidden=false;
    var w=document.getElementById('kolwait'); if(w) w.style.display='none';
  }catch(err){ _kolLoaded=false; var w2=document.getElementById('kolwait'); if(w2) w2.textContent='Gagal memuat KOL: '+err; }
}
window.addEventListener('message',function(e){var d=e&&e.data;if(!d)return;
  if(d.__kolH){var f=el('kolFrame');if(f)f.style.height=(d.__kolH+2)+'px';}
  if(d.__kolReady){kolBroadcast();kolTheme();}
  if(d.__findH){var ff=el('findFrame');if(ff)ff.style.height=(d.__findH+2)+'px';}
  if(d.__findReady){findTheme();}});
let rt; window.addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(renderCharts,150);});

renderTargets();renderAll();
