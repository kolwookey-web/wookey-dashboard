const katCol=k=>KATCOL[k]||'#8f8f86';
const katBadge=k=>k?`<span class="kbadge" style="color:${katCol(k)}">${k}</span>`:'&mdash;';
const PICORD=['Mery','Dimas','Nazwa','Muti','Dinda','Ety','Aisyah','Fikri','Vivi','Rose','Lisya','Brian','Bayu','Lila','Cibi'];
const picOrdered=(D.picList||[]).slice().sort((a,b)=>{const ia=PICORD.indexOf(a),ib=PICORD.indexOf(b);return (ia<0?99:ia)-(ib<0?99:ib);});
const KATORD=['Spesial','Pareto','KOL','Affiliate','Clipper','Berita','Internal','Anonim'];
const katOrdered=(D.katList||[]).slice().sort((a,b)=>{const ia=KATORD.indexOf(a),ib=KATORD.indexOf(b);return (ia<0?99:ia)-(ib<0?99:ib);});
function makeTable(sfx,baseKats){
  let q='',picf='',lim=25,sortK='omset',sortD=-1,katSel=new Set(),pmAllOpen=false;
  const E=id=>el(id+sfx);
  const allowed=baseKats?new Set(baseKats):null;
  const tableEl=E('tb').closest('table');
  function renderMetrics(rows){
    const cats={},T={n:0,omset:0,views:0,klik:0,vt:0};
    for(const x of rows){T.n++;T.omset+=x.omset;T.views+=x.views;T.klik+=x.klik;T.vt+=x.vt;
      const k=x.kat||'Anonim';let c=cats[k];if(!c)c=cats[k]={n:0,omset:0,views:0,klik:0,vt:0};
      c.n++;c.omset+=x.omset;c.views+=x.views;c.klik+=x.klik;c.vt+=x.vt;}
    const order=KAT_ORDER.filter(k=>cats[k]).concat(Object.keys(cats).filter(k=>!KAT_ORDER.includes(k)));
    const ctr=v=>v.views?(v.klik/v.views*100):0;
    const cards=[['Akun Kreator Omset',rp(T.n),c=>rp(c.n)],
      ['Omset',T.omset?'Rp '+jt(T.omset):'&mdash;',c=>c.omset?'Rp '+jt(c.omset):'&mdash;'],
      ['View',rp(T.views),c=>rp(c.views)],['Klik Produk',rp(T.klik),c=>rp(c.klik)],
      ['CTR',ctr(T).toFixed(2).replace('.',',')+'%',c=>ctr(c).toFixed(2).replace('.',',')+'%'],
      ['Video',rp(T.vt),c=>rp(c.vt)]];
    E('pmetrics').innerHTML=cards.map(cd=>
      `<div class="pmcard${pmAllOpen?' open':''}" data-m="${cd[0]}"><button class="pmhead" aria-expanded="${pmAllOpen?'true':'false'}"><span class="pmtxt"><span class="lab">${cd[0]}</span><span class="val">${cd[1]}</span></span><span class="pmarr">&#9662;</span></button><div class="brk">${order.map(k=>`<div><span><span class="kdot" style="background:${katCol(k)}"></span>${k}</span><b>${cd[2](cats[k])}</b></div>`).join('')}</div></div>`
    ).join('');
  }
  function render(){
    let r=agg.filter(x=>{
      if(allowed&&!allowed.has(x.kat))return false;
      if(picf&&x.pic!==picf)return false;
      if(katSel.size&&!katSel.has(x.kat))return false;
      return !q||x.user.toLowerCase().includes(q);});
    const base=allowed?agg.filter(x=>allowed.has(x.kat)).length:agg.length;
    renderMetrics(r);
    r.sort((x,y)=>{const a=x[sortK]??'',b=y[sortK]??'';return (typeof a==='string'?a.localeCompare(b):a-b)*sortD;});
    const shown=lim?r.slice(0,lim):r, maxV=Math.max(1,...r.map(x=>x.omset));
    E('cnt').textContent=(lim&&r.length>lim?shown.length+' teratas dari '+rp(r.length):rp(r.length)+' dari '+rp(base))+' kreator';
    E('tb').innerHTML=shown.map((x,i)=>`<tr><td><a class="uname" href="https://www.tiktok.com/@${encodeURIComponent(String(x.user).replace(/^@+/,''))}" target="_blank" rel="noopener">${x.user}</a><span class="rowbar" style="width:${Math.max(2,x.omset/maxV*100).toFixed(1)}%"></span></td><td>${katBadge(x.kat)}</td><td>${x.omset?'Rp '+jt(x.omset):'&mdash;'}</td><td>${rp(x.views)}</td><td>${rp(x.klik)}</td><td>${x.anom?'<span class="flag" title="Klik tidak wajar dibanding views">!</span> ':''}${x.ctr.toFixed(1).replace('.',',')}%</td><td>${rp(x.vt)}</td><td>${x.pic||'&mdash;'}</td></tr>`).join('');
  }
  E('piclist').innerHTML='<button data-pic="" aria-pressed="true">Semua PIC</button>'+picOrdered.map(p=>`<button data-pic="${p}" aria-pressed="false">${p}</button>`).join('');
  const kats=allowed?KATORD.filter(k=>allowed.has(k)):katOrdered;
  E('katlist').innerHTML=kats.map(k=>`<button data-kat="${k}" aria-pressed="false"><span class="kdot" style="background:${katCol(k)}"></span>${k}</button>`).join('');
  function closeMine(){E('katlist').hidden=true;E('piclist').hidden=true;}
  E('katbtn').addEventListener('click',e=>{e.stopPropagation();const h=E('katlist').hidden;closeMine();E('katlist').hidden=!h;});
  E('katlist').addEventListener('click',e=>{const b=e.target.closest('button[data-kat]');if(!b)return;const k=b.dataset.kat;if(katSel.has(k))katSel.delete(k);else katSel.add(k);b.setAttribute('aria-pressed',katSel.has(k)?'true':'false');E('katbtn').textContent='Kategori'+(katSel.size?' ('+katSel.size+')':'')+' ▾';render();});
  E('picbtn').addEventListener('click',e=>{e.stopPropagation();const h=E('piclist').hidden;closeMine();E('piclist').hidden=!h;});
  E('piclist').addEventListener('click',e=>{const b=e.target.closest('button[data-pic]');if(!b)return;picf=b.dataset.pic;E('piclist').hidden=true;E('picbtn').textContent=(picf||'Semua PIC')+' ▾';E('piclist').querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x.dataset.pic===picf?'true':'false'));render();});
  document.addEventListener('click',e=>{[['katlist','katbtn'],['piclist','picbtn']].forEach(a=>{const L=E(a[0]);if(L&&!L.hidden&&!L.contains(e.target)&&e.target!==E(a[1]))L.hidden=true;});});
  E('q').addEventListener('input',e=>{q=e.target.value.toLowerCase().trim();render();});
  E('topn').addEventListener('change',e=>{lim=+e.target.value;render();});
  E('pmetrics').addEventListener('click',e=>{if(!e.target.closest('.pmhead'))return;pmAllOpen=!pmAllOpen;E('pmetrics').querySelectorAll('.pmcard').forEach(c=>c.classList.toggle('open',pmAllOpen));E('pmetrics').querySelectorAll('.pmhead').forEach(h=>h.setAttribute('aria-expanded',pmAllOpen?'true':'false'));});
  tableEl.querySelectorAll('thead th[data-k]').forEach(th=>{th.tabIndex=0;
    const go=()=>{const k=th.dataset.k;if(k===sortK)sortD*=-1;else{sortK=k;sortD=(k==='user'||k==='kat'||k==='pic')?1:-1;}
      tableEl.querySelectorAll('thead th').forEach(o=>o.removeAttribute('aria-sort'));th.setAttribute('aria-sort',sortD===-1?'descending':'ascending');render();};
    th.addEventListener('click',go);th.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go();}});});
  return {render};
}
