function mkChart(box,items,series,opts){
  const n=items.length, step=Math.max(11,Math.min(46,900/n)), W=Math.max(660,n*step+72), H=opts.h||220,
        ml=58,mr=14,mt=12,mb=28,pw=W-ml-mr,ph=H-mt-mb;
  const max=Math.max(1,...items.map(d=>series.reduce((s2,k)=>s2+d[k.k],0)))*1.08;
  const y=v=>mt+ph-(v/max)*ph, bw=Math.min(26,step*0.66);
  let g='';
  for(let i=0;i<=4;i++){const v=max/4*i;
    g+=`<line class="gl" x1="${ml}" y1="${y(v).toFixed(1)}" x2="${W-mr}" y2="${y(v).toFixed(1)}"/><text class="axt" x="${ml-8}" y="${(y(v)+3.5).toFixed(1)}" text-anchor="end">${opts.fy(v)}</text>`;}
  const lab=n>60?Math.ceil(n/26):n>28?4:n>14?2:1;
  items.forEach((d,i)=>{
    const cx=ml+step*i+step/2; let acc=0;
    series.forEach(s=>{const v=d[s.k]; if(v<=0)return; const hh=Math.max(2,(v/max)*ph);
      g+=`<rect class="b" x="${(cx-bw/2).toFixed(1)}" y="${(mt+ph-acc-hh).toFixed(1)}" width="${bw.toFixed(1)}" height="${Math.max(2,hh).toFixed(1)}" rx="2" fill="${s.c}"/>`; acc+=hh;});
    if(i%lab===0) g+=`<text class="axt" x="${cx.toFixed(1)}" y="${H-9}" text-anchor="middle">${d.short}</text>`;
    g+=`<rect class="hit" data-i="${i}" x="${(cx-step/2).toFixed(1)}" y="${mt}" width="${step.toFixed(1)}" height="${ph}"/>`;
  });
  box.innerHTML=`<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="${opts.alt}">${g}</svg>`;
  const tip=document.createElement('div'); tip.className='tip'; box.appendChild(tip);
  const svg=box.querySelector('svg');
  svg.addEventListener('mousemove',e=>{const h=e.target.closest('.hit'); if(!h){tip.style.opacity=0;return;}
    const d=items[+h.dataset.i], r=box.getBoundingClientRect();
    tip.innerHTML=`<b>${d.label}</b>`+series.map(s=>`<div class="r"><span>${s.n}</span><b>${opts.ft(d[s.k])}</b></div>`).join('');
    tip.style.left=(e.clientX-r.left+box.scrollLeft)+'px'; tip.style.top=(e.clientY-r.top-14)+'px'; tip.style.opacity=1;});
  svg.addEventListener('mouseleave',()=>tip.style.opacity=0);
}
function buildSeries(){
  const span=i2-i1+1, monthly=span>120;
  const a=[],b=[],dl=[];
  if(monthly){
    const mo={};
    for(let d=i1;d<=i2;d++){const key=DATES[d].slice(0,7);
      if(!mo[key])mo[key]={gm:0,vv:0,dp:0,dg:0}; mo[key].gm+=D.dgm[d]; mo[key].vv+=D.dvv[d]; mo[key].dp+=dealDay[d]; mo[key].dg+=dealGmDay[d];}
    for(const k of Object.keys(mo).sort()){
      a.push({short:fm(k+'-01'),label:fm(k+'-01'),omset:mo[k].gm,key:k});
      b.push({short:fm(k+'-01'),label:fm(k+'-01'),views:mo[k].vv,key:k});
      dl.push({short:fm(k+'-01'),label:fm(k+'-01'),deal:mo[k].dp,dgmv:mo[k].dg,key:k});}
  }else{
    for(let d=i1;d<=i2;d++){const day=DATES[d];
      a.push({short:day.slice(8),label:fd(day),omset:D.dgm[d],key:day});
      b.push({short:day.slice(8),label:fd(day),views:D.dvv[d],key:day});
      dl.push({short:day.slice(8),label:fd(day),deal:dealDay[d],dgmv:dealGmDay[d],key:day});}
  }
  el('g1').textContent=el('g3').textContent=monthly?'per bulan':'per hari';
  return {a,b,dl};
}
function mkCombo(box,items,opts){
  const cs=getComputedStyle(document.documentElement);
  const CB=opts.cb||cs.getPropertyValue('--s2').trim(), CL=opts.cl||cs.getPropertyValue('--s1').trim();
  const n=items.length, step=Math.max(11,Math.min(46,900/n)), W=Math.max(660,n*step+104), H=opts.h||240,
        ml=60,mr=66,mt=14,mb=28,pw=W-ml-mr,ph=H-mt-mb;
  const maxL=Math.max(1,...items.map(d=>d.gm))*1.08, maxR=Math.max(1,...items.map(d=>d.vv))*1.08;
  const yR=v=>mt+ph-(v/maxR)*ph, bw=Math.min(22,step*0.6);
  let g='';
  for(let i=0;i<=4;i++){const t=i/4, yy=mt+ph-t*ph;
    g+=`<line class="gl" x1="${ml}" y1="${yy.toFixed(1)}" x2="${W-mr}" y2="${yy.toFixed(1)}"/>`;
    g+=`<text class="axt" x="${ml-8}" y="${(yy+3.5).toFixed(1)}" text-anchor="end" fill="${CB}">${jt(maxL*t)}</text>`;
    g+=`<text class="axt" x="${(W-mr+8).toFixed(1)}" y="${(yy+3.5).toFixed(1)}" text-anchor="start" fill="${CL}">${jt(maxR*t)}</text>`;}
  const lab=n>60?Math.ceil(n/26):n>28?4:n>14?2:1;
  items.forEach((d,i)=>{const cx=ml+step*i+step/2;
    if(d.gm>0){const hh=Math.max(2,(d.gm/maxL)*ph);
      g+=`<rect class="b" data-i="${i}" x="${(cx-bw/2).toFixed(1)}" y="${(mt+ph-hh).toFixed(1)}" width="${bw.toFixed(1)}" height="${hh.toFixed(1)}" rx="2" fill="${CB}"/>`;}
    if(i%lab===0) g+=`<text class="axt" x="${cx.toFixed(1)}" y="${H-9}" text-anchor="middle">${d.short}</text>`;});
  const pts=items.map((d,i)=>`${(ml+step*i+step/2).toFixed(1)},${yR(d.vv).toFixed(1)}`).join(' ');
  g+=`<polyline class="ln" points="${pts}" fill="none" stroke="${CL}" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>`;
  if(n<=62) items.forEach((d,i)=>{const cx=ml+step*i+step/2; g+=`<circle class="pt" data-i="${i}" cx="${cx.toFixed(1)}" cy="${yR(d.vv).toFixed(1)}" r="2.4" fill="${CL}"/>`;});
  items.forEach((d,i)=>{const cx=ml+step*i+step/2; g+=`<rect class="hit" data-i="${i}" x="${(cx-step/2).toFixed(1)}" y="${mt}" width="${step.toFixed(1)}" height="${ph}"/>`;});
  box.innerHTML=`<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" role="img" aria-label="${opts.alt}">${g}</svg>`;
  const tip=document.createElement('div'); tip.className='tip'; box.appendChild(tip);
  const svg=box.querySelector('svg');
  const bars=svg.querySelectorAll('.b'), dots=svg.querySelectorAll('.pt'), ln=svg.querySelector('.ln');
  function focus(bi){
    bars.forEach(el=>el.style.opacity=(bi==null||+el.dataset.i===bi)?'1':'.18');
    dots.forEach(el=>el.style.opacity=(bi==null||+el.dataset.i===bi)?'1':'.18');
    if(ln)ln.style.opacity=(bi==null)?'1':'.3';}
  svg.addEventListener('mousemove',e=>{const h=e.target.closest('.hit'); if(!h){tip.style.opacity=0;focus(null);return;}
    const bi=+h.dataset.i, d=items[bi], r=box.getBoundingClientRect();
    focus(bi);
    tip.innerHTML=`<b>${d.label}</b><div class="r"><span>${opts.lname||'Omset'}</span><b>${opts.lfmt?opts.lfmt(d.gm):'Rp '+rp(d.gm)}</b></div><div class="r"><span>${opts.rname||'Views'}</span><b>${opts.rfmt?opts.rfmt(d.vv):rp(d.vv)}</b></div>`;
    tip.style.left=(e.clientX-r.left+box.scrollLeft)+'px'; tip.style.top=(e.clientY-r.top-14)+'px'; tip.style.opacity=1;});
  svg.addEventListener('mouseleave',()=>{tip.style.opacity=0;focus(null);});
  if(opts.onpick){svg.style.cursor='pointer';
    svg.addEventListener('click',e=>{const h=e.target.closest('.hit'); if(!h)return; const d=items[+h.dataset.i]; if(d&&d.key)opts.onpick(d.key);});}
}
function pickRange(key){
  if(!key)return;
  if(key.length===7){let f=-1,l=-1;for(let d=0;d<NDAY;d++){if(DATES[d].slice(0,7)===key){if(f<0)f=d;l=d;}}if(f<0)return;i1=f;i2=l;}
  else{const d=DATES.indexOf(key);if(d<0)return;i1=d;i2=d;}
  renderAll();
}
