  if(D.jvtByCi)for(const e of D.jvtByCi){const d=e[1]; if(d<i1||d>i2)continue; vmap.set(e[0],(vmap.get(e[0])||0)+1);}
  agg=[...m.values()].map(a=>{
    a.user=D.creators[a.c];
    a.ctr=a.views?a.klik/a.views*100:0;
    a.anom=a.ctr>50;
    a.omset=a.gmv;
    a.vt=vmap.get(a.c)||0;
    a.kat=(D.ckat&&D.ckat[a.c])||'';
    a.pic=(D.cpic&&D.cpic[a.c])||'';
    return a;});
  let vv=0,kl=0,gm=0,vid=0,vtvid=0,pesan=0;
  for(let d=i1;d<=i2;d++){vv+=D.dvv[d];kl+=D.dkl[d];gm+=D.dgm[d];vid+=D.dvid[d];vtvid+=(D.dvtvid?D.dvtvid[d]:0);pesan+=(D.dpesan?D.dpesan[d]:0);}
  tot={views:vv,klik:kl,gmv:gm,vid,vtvid,pesan,aff:agg.length,baru:0};
  tot.ctr=tot.views?tot.klik/tot.views*100:0;
  tot.ctor=tot.klik?tot.pesan/tot.klik*100:0;
  // Affiliator aktif dari Data Jumlah VT (kreator unik yang posting di rentang)
  if(D.jvtrows){const seen=new Set();let ac=0,br=0;
    for(const r of D.jvtrows){const j=r[0],di=r[1]; if(di<i1||di>i2||seen.has(j))continue; seen.add(j); ac++; if(D.jcfirst[j]>=i1)br++;}
    tot.aff=ac; tot.baru=br;}
  // deal metric: hanya akun yang dideal pada rentang ini
  let dpost=0; const dset=new Set();
  dealDay=new Array(NDAY).fill(0);
  if(D.dealPosts)for(const e of D.dealPosts){const d=e[1]; if(d<i1||d>i2)continue; if(!dealt.has(e[0]))continue; dpost+=e[2]; dset.add(e[0]); dealDay[d]+=e[2];}
  tot.dpost=dpost; tot.dactive=dset.size; tot.ddeal=dealt.size; tot.dgmv=dgmv; tot.dklik=dklik;
}

