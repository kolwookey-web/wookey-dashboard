function calGrid(){
  const first=new Date(calY,calM-1,1); let sd=(first.getDay()+6)%7;
  const dim=new Date(calY,calM,0).getDate();
  let g='<div class="chd"><button class="cnav" id="cprev" type="button">&#9664;</button><b>'+BLNF[calM-1]+' '+calY+'</b><button class="cnav" id="cnext" type="button">&#9654;</button></div><div class="grid">'+DOW.map(x=>`<div class="dow">${x}</div>`).join('');
  for(let i=0;i<sd;i++)g+='<div class="dc off"></div>';
  for(let d=1;d<=dim;d++){const s=isod(calY,calM,d);const ok=inData(s);
    g+=`<div class="dc${ok?'':' off'}"${ok?' data-s="'+s+'"':''}>${d}</div>`;}
  g+='</div><div class="chint" id="chint"></div>';
  el('cal').innerHTML=g; paintCal();
}
function paintCal(){
  const lo=(selA<selB?selA:selB),hi=(selA<selB?selB:selA);
  el('cal').querySelectorAll('.dc[data-s]').forEach(c=>{const s=c.dataset.s;c.classList.remove('in','end');
    if(pickStart){if(s>=lo&&s<=hi)c.classList.add(s===lo||s===hi?'end':'in');}
    else{if(s===DATES[i1]||s===DATES[i2])c.classList.add('end');else if(s>DATES[i1]&&s<DATES[i2])c.classList.add('in');}});
